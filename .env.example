# Обязательно: токен вашего Telegram-бота от @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Опционально: битрейт аудио в кбит/с (128, 192, 320). По умолчанию 192
AUDIO_BITRATE=192

# Опционально: максимальное количество треков, скачиваемых из одного плейлиста за раз
MAX_PLAYLIST_ITEMS=50

# Опционально: максимальная длительность одного видео в секундах (по умолчанию 7200 = 2 часа)
MAX_DURATION_SECONDS=7200

# Опционально: количество одновременных скачиваний/конвертаций (по умолчанию 2)
MAX_CONCURRENT_DOWNLOADS=2

# Опционально: список Telegram ID пользователей через запятую (если пусто — бот доступен всем)
ALLOWED_USER_IDS=

# Опционально: путь к файлу cookies.txt (Netscape формат) для обхода ограничений YouTube на VPS
COOKIES_FILE=

# Опционально: прокси для yt-dlp (например, http://user:pass@host:port или socks5://host:port)
PROXY_URL=
